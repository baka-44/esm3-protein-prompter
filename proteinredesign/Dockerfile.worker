# proteinredesign GPU worker — runs the generation pipeline as a Cloud Run Job (NVIDIA L4).
# Increment 1 (preset #1): ProteinMPNN + ESMFold + ESM2. RFdiffusion3 added in M3.
#
# Build:  docker build -f proteinredesign/Dockerfile.worker -t <region>-docker.pkg.dev/<proj>/proteinredesign/worker .
# Run:    the Cloud Run Job sets PROTEINREDESIGN_MANIFEST_URI and the PROTEINREDESIGN_* bucket/project env vars.
#
# Model weights (MPNN checkpoints, ESMFold) are NOT baked in — they are mounted from
# GCS at runtime (A6) via PROTEINREDESIGN_WEIGHTS_MOUNT (gcsfuse) or downloaded by
# proteinredesign.storage.ensure_weights(). Only the tiny ESM2 scoring model is pre-baked.

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Use the base image's default python3 (Ubuntu 22.04 → 3.10) so `pip` (python3-pip)
# and `python` target the SAME interpreter. Installing python3.11 while pip targets
# 3.10 caused "No module named transformers" at build time.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev git gcc g++ \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

# torch + torchvision from the SAME CUDA wheel index — keep them consistent to avoid
# the "torchvision::nms does not exist" mismatch (same lesson as the ESM3 app Dockerfile).
RUN pip install --no-cache-dir \
        torch torchvision \
        --index-url https://download.pytorch.org/whl/cu124

# Install transformers BEFORE the esm SDK so transformers.models.esm resolves
# (the esm SDK installs a top-level `esm` module that shadows it — see esm2_scorer.py).
RUN pip install --no-cache-dir "transformers>=4.40.0"

# Pre-bake the tiny ESM2 scoring model (~30 MB) so QC scoring needs no HF network at runtime.
RUN python -c "from transformers import AutoTokenizer, EsmForMaskedLM; \
    AutoTokenizer.from_pretrained('facebook/esm2_t6_8M_UR50D'); \
    EsmForMaskedLM.from_pretrained('facebook/esm2_t6_8M_UR50D'); \
    print('ESM2 baked')"

# ESMFold (via transformers EsmForProteinFolding — avoids the fair-esm/openfold build),
# Biopython, and the GCP clients used by proteinredesign.storage / proteinredesign.jobstore.
# NOTE: ESMFold is the main build risk to validate; esmfold_v1 weights (~2.8 GB) are
#       mounted/downloaded from GCS, not baked.
RUN pip install --no-cache-dir \
        "biopython>=1.83" "numpy>=1.24" \
        "google-cloud-storage==3.13.1" "google-cloud-firestore==2.28.1" \
        "google-api-core==2.34.0" "protobuf==7.34.1"

# ProteinMPNN / SolubleMPNN / LigandMPNN — unified LigandMPNN repo (MIT).
# Its run.py imports prody + ml_collections; install those explicitly (NOT its full
# requirements.txt, which would clobber the CUDA torch we installed above).
RUN git clone --depth 1 https://github.com/dauparas/LigandMPNN.git /opt/ligandmpnn
# LigandMPNN + its vendored openfold need these pure-Python deps. We deliberately do
# NOT install its requirements.txt wholesale (it pins torch/torchvision/nvidia-* and an
# older numpy that would clobber our CUDA torch + ESMFold stack).
RUN pip install --no-cache-dir prody ml_collections dm-tree scipy pyparsing
ENV LIGANDMPNN_DIR=/opt/ligandmpnn

# App code: config.py, utils/, core/esm2_scorer.py, proteinredesign/
COPY . /app

ENTRYPOINT ["python", "-m", "proteinredesign.worker"]
