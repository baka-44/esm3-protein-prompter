# proteinredesign RF3 GPU worker — the second Cloud Run Job image (D11).
# Serves RF3-diffusion presets (#8 scaffold diversification; later #3/#6). The
# MPNN-only presets (#1/#2) keep running on the separate Python-3.10 Dockerfile.worker
# image, which this file DOES NOT touch (zero regression risk to working presets).
#
# Base: the official foundry image (Python 3.12.13, torch 2.7.1+cu126, rfd3 + MPNN
# checkpoints tooling). We layer our ESMFold + ESM2 + LigandMPNN + pipeline on top so a
# diversification job runs the whole RF3 → MPNN → ESMFold pipeline in one execution.
#
# KEY FACTS (verified via recon against foundry 0.2.0-slim):
#   * The default `python` on PATH IS the foundry uv-venv (/app/foundry/.venv) which
#     already has torch + rfd3 — so our ENTRYPOINT `python -m proteinredesign.worker`
#     runs in that same env. Good: one env, one torch.
#   * BUT that venv ships WITHOUT pip → we bootstrap pip with `ensurepip`, then install
#     our extra deps INTO the venv so the worker + rfd3 share one interpreter.
#   * Using the `-slim` base (no baked weights): RF3 weights (rfd3_latest.ckpt) are
#     fetched at runtime from the GCS weights bucket subdir rfdiffusion/ (A6) — same
#     pattern as esmfold/, mpnn/. Only the tiny ESM2 scorer (~30 MB) is baked.
#
# Build:  gcloud builds submit --config cloudbuild.rf3worker.yaml --project=phyx44-proteinredesign-v1 .

# TODO(deploy): pin the digest once validated; 0.2.0-slim is the current pinned tag.
FROM rosettacommons/foundry:0.2.0-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# The slim foundry base is minimal — it ships without git (needed to clone LigandMPNN).
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# The foundry venv has no pip — bootstrap it, then install our deps into the SAME venv
# (default `python` already resolves to /app/foundry/.venv/bin/python). torch is provided
# by the base (2.7.1+cu126) — do NOT reinstall it. No `esm` SDK (ESMFold/ESM2 come from
# transformers), so the esm-shadow + torchvision::nms issues from the ESM3 app don't apply.
RUN python -m ensurepip --upgrade && \
    # google-* pinned: unpinned rebuilds pulled api-core 2.35 / protobuf 7.36 and every
    # Firestore commit began failing with '400 Invalid database id (default)', which takes
    # the whole worker down. Bump deliberately, never as a side effect of a rebuild.
    python -m pip install --no-cache-dir \
        "transformers>=4.40.0" \
        "biopython>=1.83" \
        "google-cloud-storage==3.13.1" "google-cloud-firestore==2.28.1" \
        "google-api-core==2.34.0" "protobuf==7.34.1"

# Pre-bake the tiny ESM2 scoring model (~30 MB) so QC scoring needs no HF network at runtime.
RUN python -c "from transformers import AutoTokenizer, EsmForMaskedLM; \
    AutoTokenizer.from_pretrained('facebook/esm2_t6_8M_UR50D'); \
    EsmForMaskedLM.from_pretrained('facebook/esm2_t6_8M_UR50D'); \
    print('ESM2 baked')"

# ProteinMPNN / SolubleMPNN / LigandMPNN — unified LigandMPNN repo (MIT). Same as the
# mpnn-worker image. Install only its pure-Python deps (NOT its requirements.txt, which
# pins torch/nvidia-* and would clobber the foundry base's torch).
RUN git clone --depth 1 https://github.com/dauparas/LigandMPNN.git /opt/ligandmpnn
RUN python -m pip install --no-cache-dir prody ml_collections dm-tree scipy pyparsing
# The foundry base ships numpy 2.x (2.4.x), but LigandMPNN's vendored openfold uses
# the deprecated numpy aliases removed in numpy>=1.24/2.0 (np.int/float/bool/object/str),
# which crash at import (AttributeError: module 'numpy' has no attribute 'int'). Rewriting
# them to the builtin types is behavior-preserving (numpy's own deprecation guidance) and
# lets us keep foundry's numpy for RF3. Word-boundary sed leaves np.int64 / np.object_ etc.
# untouched. (The mpnn-worker image avoids this by pinning older numpy; here RF3 needs 2.x.)
RUN find /opt/ligandmpnn -name '*.py' -exec sed -i -E \
    's/\bnp\.int\b/int/g; s/\bnp\.float\b/float/g; s/\bnp\.bool\b/bool/g; s/\bnp\.object\b/object/g; s/\bnp\.str\b/str/g' {} +
ENV LIGANDMPNN_DIR=/opt/ligandmpnn

# App code: config.py, utils/, core/esm2_scorer.py, proteinredesign/
COPY . /app

ENTRYPOINT ["python", "-m", "proteinredesign.worker"]
